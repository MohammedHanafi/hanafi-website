---
layout: base.njk
title: Contact
description: "Contact Mohammed Hanafi. Send a message, ask a question or get in touch about working together."
active: contact
forms: true
pageHeader: true
heading: "Contact me"
permalink: /contact.html
breadcrumbs:
  - label: "Home"
    href: "/index.html"
  - label: "Contact me"
---
            <!-- Contact Start -->
            <div class="container bg-white pt-5">
                <div class="row px-3 pb-2">
                    <div class="col-sm-4 text-center mb-3">
                        <i class="fa fa-2x fa-map-marker-alt mb-3 text-primary" aria-hidden="true"></i>
                        <h3 class="h4 font-weight-bold">Address</h3>
                        <p>{{ site.address }}</p>
                    </div>
                    <div class="col-sm-4 text-center mb-3">
                        <i class="fa fa-2x fa-phone-alt mb-3 text-primary" aria-hidden="true"></i>
                        <h3 class="h4 font-weight-bold">Phone</h3>
                        <p><a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a></p>
                    </div>
                    <div class="col-sm-4 text-center mb-3">
                        <i class="far fa-2x fa-envelope mb-3 text-primary" aria-hidden="true"></i>
                        <h3 class="h4 font-weight-bold">Email</h3>
                        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
                    </div>
                </div>
                <div class="col-md-12 pb-5">
                    <div class="contact-form">
                        <form name="contact" id="contactForm" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="js-form" data-success-message="Thank you. Your message has been sent and I will reply as soon as I can." novalidate>
                            <input type="hidden" name="form-name" value="contact">
                            <p class="d-none"><label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
                            <div class="form-group">
                                <label for="name" class="sr-only">Your name</label>
                                <input type="text" class="form-control" id="name" name="name" placeholder="Your name" required autocomplete="name">
                                <div class="invalid-feedback">Enter your name.</div>
                            </div>
                            <div class="form-group">
                                <label for="email" class="sr-only">Your email</label>
                                <input type="email" class="form-control" id="email" name="email" placeholder="Your email" required autocomplete="email">
                                <div class="invalid-feedback">Enter a valid email address.</div>
                            </div>
                            <div class="form-group">
                                <label for="subject" class="sr-only">Subject</label>
                                <input type="text" class="form-control" id="subject" name="subject" placeholder="Subject" required>
                                <div class="invalid-feedback">Enter a subject.</div>
                            </div>
                            <div class="form-group">
                                <label for="message" class="sr-only">Message</label>
                                <textarea class="form-control" rows="8" id="message" name="message" placeholder="Message" required></textarea>
                                <div class="invalid-feedback">Enter your message.</div>
                            </div>
                            <div>
                                <button class="btn btn-primary" type="submit" id="sendMessageButton">Send message</button>
                            </div>
                            <div class="form-feedback mt-3" aria-live="polite"></div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Contact End -->
