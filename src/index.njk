---
layout: base.njk
title: Personal Blog
description: "Personal blog of Mohammed Hanafi, a frontend developer, entrepreneur, educator and youth development advocate writing about education and inspiring the next generation."
active: home
forms: true
pageHeader: true
heading: "Latest posts"
permalink: /index.html
breadcrumbs:
  - label: "Home"
---
            <!-- Posts Start -->
            <div class="container bg-white pt-5">
                {% for post in collections.posts %}
                <div class="row blog-item px-3 pb-5">
                    <div class="col-md-5">
                        {% if post.data.image %}
                        <a href="{{ post.url }}" tabindex="-1"><img class="post-cover-img" src="{{ post.data.image }}" alt=""></a>
                        {% else %}
                        <a href="{{ post.url }}" class="post-cover" tabindex="-1" aria-hidden="true"><i class="fas {{ post.data.icon or 'fa-graduation-cap' }}"></i></a>
                        {% endif %}
                    </div>
                    <div class="col-md-7">
                        <h2 class="h4 mt-md-4 px-md-3 mb-2 py-2 bg-white font-weight-bold"><a href="{{ post.url }}" class="text-secondary">{{ post.data.title }}</a></h2>
                        <div class="d-flex mb-3">
                            <small class="mr-3 text-muted"><i class="fa fa-calendar-alt" aria-hidden="true"></i> {{ post.data.date | readableDate }}</small>
                            <small class="mr-3 text-muted"><i class="fa fa-folder" aria-hidden="true"></i> {{ post.data.category }}</small>
                        </div>
                        <p>{{ post.data.excerpt }}</p>
                        <a class="btn btn-link p-0" href="{{ post.url }}">Read article <i class="fa fa-angle-right" aria-hidden="true"></i></a>
                    </div>
                </div>
                {% else %}
                <div class="row px-3 pb-5">
                    <div class="col-12">
                        <p class="text-muted m-0">No articles published yet. Check back soon.</p>
                    </div>
                </div>
                {% endfor %}
            </div>
            <!-- Posts End -->

            <!-- Subscribe Start -->
            <div class="container py-5 px-4 bg-secondary text-center">
                <h2 class="text-white font-weight-bold">Subscribe to my newsletter</h2>
                <p class="text-white">Subscribe and get my latest article in your inbox.</p>
                <form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="js-form" data-invalid-message="Enter a valid email address." data-success-message="Thanks for subscribing!" novalidate>
                    <input type="hidden" name="form-name" value="newsletter">
                    <p class="d-none"><label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
                    <div class="input-group mx-auto newsletter-group">
                        <input type="email" name="email" class="form-control" placeholder="Your email" aria-label="Your email" autocomplete="email" required>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit">Subscribe</button>
                        </div>
                    </div>
                    <div class="form-feedback newsletter-group mx-auto mt-3 text-left" aria-live="polite"></div>
                </form>
            </div>
            <!-- Subscribe End -->
