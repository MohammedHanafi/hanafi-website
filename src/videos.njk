---
layout: base.njk
title: Videos
description: "Watch the latest videos from Mohammed Hanafi's YouTube channel."
active: videos
pageHeader: true
heading: "Videos"
permalink: "/videos/"
videosPage: true
breadcrumbs:
  - label: "Home"
    href: "/"
  - label: "Videos"
---
            <!-- Videos Start -->
            <div class="container bg-white pt-5 pb-5">
                <div class="row px-3 pb-4">
                    <div class="col-12">
                        <p class="mb-4">
                            The latest videos from my YouTube channel. Tap one to play it right here. This list refreshes whenever the site is updated, and the channel always has everything.
                        </p>
                    </div>
                </div>
                <div class="row px-3">
                    {% for v in videos %}
                    <div class="col-6 col-md-4 col-lg-3 mb-4">
                        <button type="button" class="video-tile" data-video-id="{{ v.id }}" aria-label="Play: {{ v.title }}">
                            <span class="video-tile-thumb">
                                <img src="{{ v.thumbnail }}" alt="" loading="lazy">
                                <span class="video-tile-play" aria-hidden="true"><i class="fas fa-play"></i></span>
                            </span>
                            <span class="video-tile-title">{{ v.title }}</span>
                        </button>
                    </div>
                    {% else %}
                    <div class="col-12">
                        <p class="text-muted mb-4">Videos couldn't be loaded right now.</p>
                    </div>
                    {% endfor %}
                </div>
                <div class="row px-3">
                    <div class="col-12">
                        <a href="{{ site.youtube }}" target="_blank" rel="noopener" class="btn btn-primary"><i class="fab fa-youtube mr-1" aria-hidden="true"></i> Watch more on YouTube</a>
                    </div>
                </div>
            </div>
            <!-- Videos End -->

            <!-- Video player: opens over the page when a tile is tapped (see /js/videos.js) -->
            <div id="videoLightbox" class="video-lightbox" role="dialog" aria-modal="true" aria-label="Video player" hidden>
                <div class="video-lightbox-inner">
                    <button type="button" class="video-lightbox-close" aria-label="Close video">&times;</button>
                    <div class="video-lightbox-frame" id="videoLightboxFrame"></div>
                </div>
            </div>
