---
layout: base.njk
title: Blog
description: "Articles by Mohammed Hanafi on education, inspiration and the state of Ghana's education system."
active: blog
pageHeader: true
heading: "My blog"
permalink: /blog.html
breadcrumbs:
  - label: "Home"
    href: "/index.html"
  - label: "My blog"
---{% from "macros.njk" import postCard %}
            <!-- Blog List Start -->
            <div class="container bg-white pt-5">
                {% for group in collections.postsByCategory %}
                <h2 class="h4 font-weight-bold mb-4 px-3{% if not loop.first %} mt-3{% endif %}">{{ group.category }}</h2>
                <div class="row px-3">
                    {% for post in group.posts %}
                    <div class="col-md-6 col-lg-4 mb-4 d-flex">{{ postCard(post, site) }}</div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="row px-3 pb-5">
                    <div class="col-12">
                        <p class="text-muted m-0">No articles yet. Check back soon.</p>
                    </div>
                </div>
                {% endfor %}
                <div class="pb-3"></div>
            </div>
            <!-- Blog List End -->
