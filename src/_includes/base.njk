<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ title }} | {{ site.name }}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="description" content="{{ description or excerpt }}">
    <meta name="author" content="{{ site.name }}">
    <meta name="theme-color" content="#2A4B7C">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title }} | {{ site.name }}">
    <meta property="og:description" content="{{ description or excerpt }}">

    <link href="/favicon.ico" rel="icon" sizes="any">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">

    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/custom.css" rel="stylesheet">
</head>
<body>
    <a class="sr-only sr-only-focusable skip-link" href="#main">Skip to main content</a>
    <div class="wrapper">
        <div class="sidebar">
            <div class="sidebar-text d-flex flex-column h-100 justify-content-center text-center">
                <img class="mx-auto d-block w-75 bg-primary img-fluid rounded-circle mb-4 p-3" src="/img/hanafi.jpg" width="500" height="500" alt="Portrait of {{ site.name }}">
                <h1 class="font-weight-bold">{{ site.name }}</h1>
                <p class="mb-4">
                    I am a multi-talented individual with a variety of skills. I am a Frontend Developer, an Entrepreneur, a Youth Influencer and a Teacher.
                </p>
                <div class="d-flex flex-wrap justify-content-center mb-5">
                    <a class="btn btn-outline-primary mr-2" href="{{ site.twitter }}" target="_blank" rel="noopener" aria-label="X (Twitter)"><i class="fab fa-twitter"></i></a>
                    <a class="btn btn-outline-primary mr-2" href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a class="btn btn-outline-primary mr-2" href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a class="btn btn-outline-primary mr-2" href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a class="btn btn-outline-primary mr-2" href="{{ site.github }}" target="_blank" rel="noopener" aria-label="GitHub"><i class="fab fa-github"></i></a>
                </div>
                <a href="/contact.html" class="btn btn-lg btn-block btn-primary mt-auto">Hire Me</a>
            </div>
            <div class="sidebar-icon d-flex flex-column h-100 justify-content-center text-right">
                <i class="fas fa-2x fa-angle-double-right text-primary" aria-hidden="true"></i>
            </div>
        </div>
        <div class="content">
            <div class="container p-0">
                <nav class="navbar navbar-expand-lg bg-secondary navbar-dark" aria-label="Main navigation">
                    <a href="/index.html" class="navbar-brand d-block d-lg-none">Menu</a>
                    <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                        <div class="navbar-nav m-auto">
                            <a href="/index.html" class="nav-item nav-link{% if active == 'home' %} active{% endif %}"{% if active == 'home' %} aria-current="page"{% endif %}>Home</a>
                            <a href="/about.html" class="nav-item nav-link{% if active == 'about' %} active{% endif %}"{% if active == 'about' %} aria-current="page"{% endif %}>About</a>
                            <a href="/blog.html" class="nav-item nav-link{% if active == 'blog' %} active{% endif %}"{% if active == 'blog' %} aria-current="page"{% endif %}>Blog</a>
                            <a href="/contact.html" class="nav-item nav-link{% if active == 'contact' %} active{% endif %}"{% if active == 'contact' %} aria-current="page"{% endif %}>Contact</a>
                        </div>
                    </div>
                </nav>
            </div>

            {% if pageHeader %}
            <div class="container py-5 px-2 bg-primary">
                <div class="row py-5 px-4">
                    <div class="col-sm-6 text-center text-md-left">
                        <h2 class="page-title mb-3 mb-md-0 text-white text-uppercase font-weight-bold">{{ heading or title }}</h2>
                    </div>
                    <div class="col-sm-6 text-center text-md-right">
                        <div class="d-inline-flex pt-2">
                            {% for crumb in breadcrumbs %}
                                {% if not loop.first %}<h4 class="m-0 text-white px-2">/</h4>{% endif %}
                                {% if crumb.href %}<h4 class="m-0 text-white"><a class="text-white" href="{{ crumb.href }}">{{ crumb.label }}</a></h4>
                                {% else %}<h4 class="m-0 text-white">{{ crumb.label }}</h4>{% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

            <main id="main">
{{ content | safe }}
            </main>

            <div class="container py-4 bg-secondary text-center">
                <p class="m-0 text-white">
                    &copy; <span class="js-year">2026</span> <a class="text-white font-weight-bold" href="/index.html">{{ site.name }}</a>. All Rights Reserved. Designed by <a class="text-white font-weight-bold" href="https://alkssystems.com" target="_blank" rel="noopener">Alks-Systems</a>
                </p>
            </div>
        </div>
    </div>

    <a href="#" class="back-to-top" aria-label="Back to top"><i class="fa fa-angle-double-up" aria-hidden="true"></i></a>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/easing/easing.min.js"></script>
    <script src="/js/main.js"></script>
    {% if forms %}<script src="/js/forms.js"></script>{% endif %}
</body>
</html>
