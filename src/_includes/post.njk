---
layout: base.njk
pageHeader: true
heading: "Article"
share: true
ogType: article
breadcrumbs:
  - label: "Home"
    href: "/"
  - label: "My blog"
    href: "/blog/"
  - label: "Article"
---
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BlogPosting",
                "headline": {{ title | jsonSafe | safe }},
                "description": {{ excerpt | jsonSafe | safe }},
                "datePublished": "{{ date | isoDate }}",
                "dateModified": "{{ (updated or date) | isoDate }}",
                "author": { "@type": "Person", "name": {{ (author or site.name) | jsonSafe | safe }} },
                "publisher": {
                    "@type": "Organization",
                    "name": {{ site.brand | jsonSafe | safe }},
                    "logo": { "@type": "ImageObject", "url": "{{ site.siteUrl }}/img/alks-logo.png" }
                },
                "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ site.siteUrl }}{{ page.url }}" },
                "image": ["{{ site.siteUrl }}{{ image or '/img/og-default.jpg' }}"],
                "articleSection": {{ category | jsonSafe | safe }},
                "inLanguage": "en"{% if tags %},
                "keywords": {{ tags | join(", ") | jsonSafe | safe }}{% endif %}
            }
            </script>
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.siteUrl }}/" },
                    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.siteUrl }}/blog/" },
                    { "@type": "ListItem", "position": 3, "name": {{ title | jsonSafe | safe }} }
                ]
            }
            </script>
            <!-- Article Start -->
            <div class="container py-5 px-3 bg-white">
                <div class="row px-4">
                    <div class="col-12">
                        {% if image %}
                        {% set heroSrcset = image | imgSrcset %}<img class="post-cover-img post-cover-img-lg" src="{{ image }}"{% if heroSrcset %} srcset="{{ heroSrcset }}" sizes="(min-width: 1200px) 1100px, 100vw"{% endif %} alt="" fetchpriority="high">
                        {% else %}
                        <div class="post-cover post-cover-lg" aria-hidden="true"><i class="fas {{ icon or 'fa-graduation-cap' }}"></i></div>
                        {% endif %}
                        <article class="article-body">
                            <h2 class="my-4 font-weight-bold">{{ title }}</h2>
                            <div class="d-flex mb-4 text-muted">
                                <span class="mr-3"><i class="fa fa-calendar-alt" aria-hidden="true"></i> {{ date | readableDate }}</span>
                                <span class="mr-3"><i class="fa fa-folder" aria-hidden="true"></i> {{ category }}</span>
                            </div>

                            {% set videoId = video | youtubeId %}
                            {% if videoId %}
                            <div class="video-embed mb-4">
                                <iframe
                                    src="https://www.youtube-nocookie.com/embed/{{ videoId }}"
                                    title="Video for {{ title }}"
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen>
                                </iframe>
                            </div>
                            {% endif %}

{{ content | safe }}
                        </article>
                    </div>
                    {% if tags %}
                    <div class="col-12 py-4">
                        {% for tag in tags %}<span class="badge badge-primary post-tag">{{ tag }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    <div class="col-12 pb-4">
                        <h3 class="h6 font-weight-bold mb-3">Share this article</h3>
                        <div class="d-flex flex-wrap share-links">
                            <a href="#" data-share="twitter" class="btn btn-outline-primary btn-sm mr-2 mb-2" aria-label="Share on X (Twitter)"><i class="fab fa-twitter"></i></a>
                            <a href="#" data-share="facebook" class="btn btn-outline-primary btn-sm mr-2 mb-2" aria-label="Share on Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" data-share="linkedin" class="btn btn-outline-primary btn-sm mr-2 mb-2" aria-label="Share on LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#" data-share="whatsapp" class="btn btn-outline-primary btn-sm mr-2 mb-2" aria-label="Share on WhatsApp"><i class="fab fa-whatsapp"></i></a>
                            <button type="button" data-share="copy" class="btn btn-outline-secondary btn-sm mb-2" aria-label="Copy link to this article"><i class="fa fa-link" aria-hidden="true"></i> <span class="copy-label">Copy link</span></button>
                        </div>
                    </div>
                    <div class="col-12 py-4">
                        <div class="p-4 bg-light">
                            <h3 class="mb-2 font-weight-bold">Have a thought on this article?</h3>
                            <p class="mb-3">I would love to hear it. Send me a message and I will get back to you.</p>
                            <a href="/contact/" class="btn btn-primary mr-2 mb-2">Send a message</a>
                            <a href="/blog/" class="btn btn-outline-primary mb-2">Back to the blog</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Article End -->
